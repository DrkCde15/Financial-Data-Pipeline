# Copie para .env e ajuste conforme necessário. Nunca versione o .env real.
# Diretórios relativos à raiz do projeto (financial-data-pipeline/).
RAW_DATA_DIR=data/raw
BRONZE_DATA_DIR=data/bronze
SILVER_DATA_DIR=data/silver
GOLD_DATA_DIR=data/gold

# Seed para geração reproduzível dos dados sintéticos
SYNTHETIC_SEED=42

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Serving (PostgreSQL). Local via compose, testes via SQLite.
# Ex.: postgresql+psycopg://postgres:postgres@localhost:5432/finance
# Ex.: sqlite:////tmp/finance.db
DATABASE_URL=

# Airflow: raiz do repo dentro dos containers (ver docker-compose.yml)
FINANCIAL_PIPELINE_ROOT=/opt/airflow/financial-data-pipeline
